{
	"name": "site-scaffold",
	"private": true,
	"type": "module",
	"version": "0.0.0",
	"scripts": {
		"build": "vite build",
		"cf-typegen": "wrangler types",
		"check-types": "tsc --noEmit",
		"deploy": "vite build && wrangler deploy",
		"dev": "vite --port 5174",
		"lint": "prettier --write . && eslint .",
		"start": "wrangler dev",
		"test": "vitest --run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@cloudflare/vite-plugin": "^1.51.1",
		"@eslint/js": "^9.30.1",
		"@tailwindcss/vite": "^4.1.11",
		"@types/lodash": "^4.17.20",
		"@types/node": "^24.0.10",
		"@types/react": "^19.1.8",
		"@types/react-dom": "^19.1.6",
		"@vitejs/plugin-react": "^4.6.0",
		"eslint": "^9.30.1",
		"eslint-plugin-react-hooks": "^5.2.0",
		"globals": "^16.0.0",
		"lodash": "^4.17.21",
		"marked": "^18.0.3",
		"prettier": "^3.6.2",
		"prettier-plugin-tailwindcss": "^0.6.13",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"tailwindcss": "^4.1.11",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.35.1",
		"use-infer": "^1.0.9",
		"use-request-utils": "^1.0.88",
		"vite": "^6.2.0",
		"wrangler": "^4.120.0"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.20.2",
		"@eslint-react/eslint-plugin": "^5.14.7",
		"@feliperohdee/eslint-plugin-imports": "^1.0.1",
		"@tailwindcss/typography": "^0.5.19",
		"vitest": "^4.1.0"
	},
	"resolutions": {
		"vite": "^6.2.0"
	}
}
